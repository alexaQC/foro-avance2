# Copia este archivo como .env y coloca tus valores reales.
# El archivo .env esta protegido por .gitignore y NO debe subirse.

# Aplicacion
SECRET_KEY=coloca-aqui-una-clave-segura

# Base de datos RDS PostgreSQL
DATABASE_URL=postgresql+psycopg2://usuario:password@host-rds:5432/foro

# AWS
AWS_REGION=us-east-1
S3_BUCKET=nombre-del-bucket
AWS_ACCESS_KEY_ID=mi-access-key
AWS_SECRET_ACCESS_KEY=mi-secret-access-key
AWS_SESSION_TOKEN=mi-session-token

# Servicio de moderacion
MODERACION_URL=http://moderacion:5001/moderar